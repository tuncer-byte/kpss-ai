rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Kullanici yalnizca kendi dokumanini okur/yazar (misafir dahil).
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
    // Uzaktan ayar: herkes okur, istemci yazamaz (Console'dan duzenlenir).
    match /config/{doc} {
      allow read: if true;
      allow write: if false;
    }
  }
}
